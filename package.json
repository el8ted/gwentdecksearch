{
  "name": "gwent-deck-search",
  "version": "1.0.0",
  "description": "Static SPA for filtering curated Gwent decks by leader, stratagem and cards",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "scrape": "node scripts/cards.ts && node scripts/decks.ts && node --env-file-if-exists=.env scripts/videos.ts && node scripts/build-data.ts",
    "build:data": "node scripts/build-data.ts",
    "scrape:cards": "node scripts/cards.ts",
    "scrape:decks": "node scripts/decks.ts",
    "scrape:videos": "node --env-file-if-exists=.env scripts/videos.ts",
    "typecheck": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "screenshots": "node scripts/screenshots.ts",
    "reddit": "node scripts/reddit.ts",
    "readmes": "node scripts/readme-stubs.ts",
    "kegs": "node scripts/kegs.ts",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "keywords": [],
  "author": "el8ted",
  "license": "PolyForm-Noncommercial-1.0.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "consola": "^3.4.2",
    "eld": "^2.1.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "private": true
}
